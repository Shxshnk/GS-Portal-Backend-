# Server Configuration
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=i_portal
DB_USER=root
DB_PASS=your_db_password_here

# AWS Global / Default Credentials
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_default_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_default_aws_secret_access_key_here
AWS_PROFILE=your_optional_aws_profile_here

# Ground Station 1 / SD1 / CP1 Credentials & Telemetry Configuration
CP1_AWS_REGION=af-south-1
CP1_AWS_ACCESS_KEY_ID=your_cp1_aws_access_key_id_here
CP1_AWS_SECRET_ACCESS_KEY=your_cp1_aws_secret_access_key_here
# CP1_AWS_PROFILE=your_optional_cp1_profile_here
CP1_CLOUDWATCH_NAMESPACE=GroundStation/SDR
CP1_GROUND_STATION=GS-001
CP1_REGION=Africa
CP1_RECEIVER=IFR-1

# Ground Station 2 / SD2 / CP2 Credentials & Telemetry Configuration
CP2_AWS_REGION=af-south-1
CP2_AWS_ACCESS_KEY_ID=your_cp2_aws_access_key_id_here
CP2_AWS_SECRET_ACCESS_KEY=your_cp2_aws_secret_access_key_here
# CP2_AWS_PROFILE=your_optional_cp2_profile_here
CP2_CLOUDWATCH_NAMESPACE=GroundStation/SDR
CP2_GROUND_STATION=GS-001
CP2_REGION=Africa
CP2_RECEIVER=IFR-1